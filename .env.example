# Copy this file to .env.local and fill in the two values from
# Supabase: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Phone (calls and texts). See docs/PHONE_SETUP.md.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=https://your-serviceflo-address
